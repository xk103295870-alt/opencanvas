{
  "name": "canvas-workbench",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "canvas-workbench": "./bin/canvas-workbench.mjs"
  },
  "scripts": {
    "dev": "vite",
    "api:dev": "tsx server/index.ts",
    "dev:webapi": "tsx --tsconfig tsconfig.node.json server/index.ts",
    "cli": "node ./bin/canvas-workbench.mjs",
    "build": "tsc -b && vite build",
    "build:obsidian": "tsc -p tsconfig.obsidian.json && vite build --config vite.obsidian.config.ts",
    "icons:generate": "node scripts/generate-icons.mjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "obsidian": "^1.8.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.21.0",
    "vite": "^7.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0"
  }
}
